# 复制为 .env 后填写（.env 已被 .gitignore 屏蔽，永不入库）
# 完整配置项与默认值见 docs/开发文档.md §2.3

# ---- 必需：向量库 ----
# 支持三种形态：Qdrant Cloud / 自建服务（http(s) 地址）、
# :memory:（进程内，重启即清空）、本地目录路径（嵌入式，数据落盘）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=bid_qa
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ---- LLM（缺省则降级为「直接返回知识库原文」，服务仍可用）----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 检索 ----
# 精排（CrossEncoder 二次排序）。默认关闭，两个原因：
#   1) 当前 75 条语料下实测无提升——混合检索基线 Top-1 已 98.7%，精排后持平
#      （见 eval/retrieval_eval.py 与 docs/技术栈.md 的踩坑记录）；
#   2) 需下载 bge-reranker-base（约 1.1GB），且 CPU 上约 0.9s/查询。
# 语料扩大后值得重测再开。
RERANK_ENABLED=0
# 启动时后台预热嵌入模型；测试环境建议置 0
WARMUP_ON_START=1

# ---- 模型下载镜像（国内必需）----
HF_ENDPOINT=https://hf-mirror.com

# ---- API 服务 ----
API_HOST=0.0.0.0
API_PORT=8001
# 逗号分隔白名单；* 允许所有；留空 = 仅本地开发端口
CORS_ORIGINS=

# ---- 出站代理（显式配置才生效，见 docs/开发文档.md §11.3）----
HTTP_PROXY=
HTTPS_PROXY=

# =====================================================================
# 以下为「图谱 / 数据库 / 联网搜索」配置：对应模块尚未实现（见 README 状态表），
# 预先保留以便 teammates 按 docs/开发文档.md 契约接入时无需再改本文件。
# =====================================================================

# ---- 知识图谱（Neo4j）----
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- 结构化数据库（PostgreSQL）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# ---- 联网搜索 ----
TAVILY_API_KEY=
EXA_API_KEY=

# ---- 其他 LLM Provider（可选）----
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flashx
